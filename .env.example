# Backend (Django) ile paylaşılan anahtar: X-API-Key başlığında gönderilir
MSP_API_KEY=change-me

# llamacpp | openai | mock
MSP_BACKEND=openai
MSP_OPENAI_BASE_URL=http://localhost:8001/v1
MSP_OPENAI_MODEL=qwen2.5-coder-7b

# llamacpp için: MSP_DEFAULT_MODEL_PATH=models/qwen2.5-coder-3b-instruct-q4_k_m.gguf
# VRAM yetmezse katmanların bir kısmını GPU'ya ver (0 = yalnızca CPU)
MSP_N_GPU_LAYERS=-1
MSP_N_CTX=4096
MSP_MAX_SECTION_TOKENS=1200
MSP_MAX_SECTIONS=10
MSP_WORKERS=1

# Docker kalıcı verisi (ajan verisi, vLLM önbelleği). Boşsa ./docker-data
# MSP_DOCKER_DATA=E:/mysimplepages
