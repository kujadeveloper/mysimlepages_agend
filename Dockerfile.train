# QLoRA eğitim imajı (NVIDIA GPU, Linux konteyneri). Kod ve veri imaja kopyalanmaz, çalışırken bağlanır
# (docker-compose.train.yaml), böylece örnek ekleyip kodu değiştirdiğinizde yeniden derleme gerekmez.
# torch cu128: Blackwell (RTX 50xx) dahil güncel kartları destekler.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app MSP_DATA_DIR=/app/data \
    HF_HOME=/app/models/.hf-cache PIP_NO_CACHE_DIR=1

RUN pip install torch --index-url https://download.pytorch.org/whl/cu128 \
 && pip install "transformers>=4.56" "peft>=0.12" "datasets>=2.20" "accelerate>=0.33" "bitsandbytes>=0.45" \
    "huggingface_hub[cli]" "pydantic>=2.7" "pydantic-settings>=2.3" "fastapi>=0.115" "httpx>=0.27" pytest

WORKDIR /app
CMD ["python", "-c", "import torch;print('torch', torch.__version__, 'cuda', torch.cuda.is_available(), torch.cuda.get_device_name(0) if torch.cuda.is_available() else '')"]
